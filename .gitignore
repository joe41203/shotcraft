node_modules/
.output/
.wxt/
.DS_Store
.claude/

# LP デプロイ（wrangler）の一時ファイル
.wrangler/

# ストア提出・動作確認で使う Chrome の作業用プロファイル。
# 通常はスクラッチパッド配下に作って作業後に削除するが、リポジトリ内に置いた場合に
# 誤ってコミットしないよう明示する（Google のログインセッションを含むため）。
chrome-cws/
chrome-profile/
.chrome-*/

# HyperFrames 動画プロジェクトの生成物（ソースの index.html / compositions は追跡する）
videos/*/renders/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/node_modules/
# capture/assets は docs/images と public/icon の複製（no-capture パスで手動コピー）
videos/*/capture/assets/
